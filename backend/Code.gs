/** AutoLead AI isolated TEST intake. No production collection path exists. */
var DR = Object.freeze({mode:'TEST',policy:'test-2026-10-22-v1',origin:'https://autoleadaigmn-rgb.github.io',path:'/avtoleadtest/',maxDaily:3,cooldown:15});
var DR_HEADERS=['Request ID','Received UTC','Mode','Name','Contact','Service','Vehicle','Description','Preferred time','Consent version','Consent UTC','Status','Notification','Payload hash'];

function showDemoAuthorization() {
  var info=ScriptApp.getAuthorizationInfo(ScriptApp.AuthMode.FULL);
  console.log('Authorization status: '+info.getAuthorizationStatus());
  if(info.getAuthorizationStatus()===ScriptApp.AuthorizationStatus.REQUIRED)console.log('Google consent URL: '+info.getAuthorizationUrl());
}
function setupDemoRequests() {
  ScriptApp.requireAllScopes(ScriptApp.AuthMode.FULL);
  var p=PropertiesService.getScriptProperties(),owner=Session.getEffectiveUser().getEmail();
  if(!/^[^\s@]+@gmail\.com$/i.test(owner))throw new Error('Run setup as the confirmed Gmail owner.');
  if(p.getProperty('OWNER_EMAIL')&&p.getProperty('OWNER_EMAIL')!==owner)throw new Error('Owner mismatch.');
  p.setProperty('OWNER_EMAIL',owner);
  var id=p.getProperty('REQUESTS_SHEET_ID'),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('AutoLead AI — Demo Requests');
  if(!id){var s=ss.getSheets()[0];s.setName('Demo Requests');s.getRange(1,1,1,DR_HEADERS.length).setValues([DR_HEADERS]).setBackground('#182321').setFontColor('#ffffff').setFontWeight('bold');s.setFrozenRows(1);s.setColumnWidths(1,DR_HEADERS.length,160);s.setColumnWidth(8,300);s.getRange('A:N').setWrap(true);s.getRange(1,1,1,DR_HEADERS.length).createFilter();p.setProperty('REQUESTS_SHEET_ID',ss.getId());}
  p.setProperty('INTAKE_MODE','TEST');
  console.log(JSON.stringify({mode:'TEST',owner:owner,sheet:ss.getUrl(),realData:'REJECTED',dailyLimit:DR.maxDaily}));
}

function doGet(e){
 if(e&&e.parameter&&e.parameter.owner==='1'){
  try{drOwner_();return HtmlService.createHtmlOutput(drOwnerHtml_()).setTitle('AutoLead AI — Owner dashboard').addMetaTag('viewport','width=device-width, initial-scale=1');}
  catch(err){return HtmlService.createHtmlOutput('<h1>Owner sign-in required</h1><p>This dashboard is private. Use the owner-only deployment and the verified Google account. No request data was disclosed.</p>');}
 }
 return drJson_({ok:true,mode:'TEST',realDataAccepted:false,policy:DR.policy,shop:drPublicConfig_()});
}
function doPost(e){
  try{
    if(!e||!e.postData||e.postData.contents.length>6000)return drJson_({ok:false,code:'INVALID_BODY'});
    var input=JSON.parse(e.postData.contents),valid=drValidate_(input,Date.now());
    if(!valid.ok)return drJson_(valid);
    return drJson_(drReceive_(valid.data));
  }catch(err){console.error('Demo intake failed; no request payload logged.');return drJson_({ok:false,code:'SERVER_ERROR',retryable:true});}
}

function drValidate_(x,now){
  var fail=function(code){return {ok:false,code:code};};
  if(!x||typeof x!=='object'||Array.isArray(x))return fail('INVALID_BODY');
  if(x.website)return fail('SPAM_REJECTED');
  if(x.mode!=='TEST'||x.policy!==DR.policy||x.consent!==true)return fail('CONSENT_REQUIRED');
  if(x.site!==DR.origin+DR.path)return fail('SITE_REJECTED');
  if(typeof x.id!=='string'||!/^[a-f0-9-]{36}$/i.test(x.id))return fail('INVALID_ID');
  if(!Number.isFinite(x.startedAt)||now-x.startedAt<3000||now-x.startedAt>3600000)return fail('TIMING_REJECTED');
  if(!Number.isFinite(x.consentedAt)||Math.abs(now-x.consentedAt)>300000)return fail('CONSENT_EXPIRED');
  var allowed={name:['Alex Demo'],contact:['alex@example.com'],service:['Oil & filter change','Brake inspection','Tire service','Engine diagnostics','Routine maintenance'],vehicle:['2019 Toyota Camry'],issue:['Routine service before a road trip','Brakes squeal when stopping','Tire losing air','Check engine light is on'],preferredTime:['Next weekday morning','No preference']};
  var data={id:x.id,consentedAt:x.consentedAt};
  for(var key in allowed){if(typeof x[key]!=='string'||!x[key].trim())return fail('REQUIRED_FIELDS');var value=x[key].trim();if(allowed[key].indexOf(value)<0)return fail('TEST_DATA_ONLY');data[key]=value;}
  return {ok:true,data:data};
}

function drReceive_(d){
  var lock=LockService.getScriptLock();if(!lock.tryLock(10000))return {ok:false,code:'BUSY',retryable:true};
  try{
    var p=PropertiesService.getScriptProperties();
    if(p.getProperty('INTAKE_MODE')!=='TEST')return {ok:false,code:'INTAKE_DISABLED'};
    var sheetId=p.getProperty('REQUESTS_SHEET_ID'),owner=p.getProperty('OWNER_EMAIL');
    if(!sheetId||!owner)return {ok:false,code:'NOT_CONFIGURED'};
    var sheet=SpreadsheetApp.openById(sheetId).getSheetByName('Demo Requests');
    var fingerprint=drHash_([d.name,d.contact,d.service,d.vehicle,d.issue,d.preferredTime].join('\n'));
    var rows=sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,DR_HEADERS.length).getValues():[];
    var now=Date.now(),today=new Date(now).toISOString().slice(0,10),daily=0,last=0;
    for(var i=0;i<rows.length;i++){
      var r=rows[i],received=new Date(r[1]).getTime();
      if(r[0]===d.id||(r[13]===fingerprint&&now-received<86400000))return {ok:true,mode:'TEST',receipt:r[0],duplicate:true,notification:r[12]};
      if(new Date(received).toISOString().slice(0,10)===today)daily++;
      last=Math.max(last,received);
    }
    if(daily>=DR.maxDaily)return {ok:false,code:'DAILY_LIMIT'};
    if(now-last<DR.cooldown*1000)return {ok:false,code:'RATE_LIMIT',retryable:true};
    if(MailApp.getRemainingDailyQuota()<1)return {ok:false,code:'EMAIL_QUOTA',retryable:true};
    var row=sheet.getLastRow()+1;
    sheet.getRange(row,1,1,DR_HEADERS.length).setValues([[d.id,new Date(now).toISOString(),'TEST',d.name,d.contact,d.service,d.vehicle,d.issue,d.preferredTime,DR.policy,new Date(d.consentedAt).toISOString(),'NEW','SENDING',fingerprint]]);
    SpreadsheetApp.flush();
    var notification='SENT';
    try{
      MailApp.sendEmail({to:owner,subject:'[AutoLead TEST] New demo request — '+d.service,body:'TEST ONLY — fictional details. No customer email was sent.\n\nRequest: '+d.id+'\nName: '+d.name+'\nContact: '+d.contact+'\nService: '+d.service+'\nVehicle: '+d.vehicle+'\nDescription: '+d.issue+'\nPreferred time (not confirmed): '+d.preferredTime+'\n\nPrivate owner sheet: https://docs.google.com/spreadsheets/d/'+sheetId+'/edit\nConsent: '+DR.policy+'\n\nDo not reply to the sample contact. Public collection of real data is disabled.',name:'AutoLead AI Test'});
    }catch(err){notification='FAILED_REVIEW';console.error('Owner notification requires review; automatic resend disabled.');}
    sheet.getRange(row,13).setValue(notification);SpreadsheetApp.flush();
    return {ok:true,mode:'TEST',receipt:d.id,duplicate:false,notification:notification};
  }finally{lock.releaseLock();}
}
function drHash_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');}
function drJson_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function disableDemoIntake(){PropertiesService.getScriptProperties().setProperty('INTAKE_MODE','DISABLED');console.log('Intake disabled. Existing rows retained.');}

// Every owner RPC checks Google identity before opening any Sheet or returning private configuration.
function drOwner_(){var p=PropertiesService.getScriptProperties(),active=Session.getActiveUser().getEmail().toLowerCase(),owner=(p.getProperty('OWNER_EMAIL')||'').toLowerCase();if(!active||!owner||active!==owner)throw new Error('ACCESS_DENIED: sign in as the verified owner.');return {properties:p,email:owner};}
function drPublicConfig_(){var raw=PropertiesService.getScriptProperties().getProperty('SHOP_CONFIG');return raw?JSON.parse(raw):{id:'bayline-demo',name:'Bayline Auto Care',city:'Houston, TX',fictional:true,logoUrl:'',colors:{primary:'#182321',accent:'#d7fa75',background:'#f8faf6'},contact:{email:'',phone:'',address:''},hours:'Monday–Friday, 8 am–6 pm. Saturday, 9 am–1 pm. Sunday closed. US Central.',services:['Oil & filter change','Brake inspection','Tire service','Engine diagnostics','Routine maintenance'],greeting:'Hi! I’m the demo receptionist for Bayline Auto Care. Share your vehicle, concern, preferred time and sample contact together if you like. This is a fictional, rules-based demo, not generative AI.'};}
function ownerBootstrap(){var auth=drOwner_();return {email:auth.email,mode:auth.properties.getProperty('INTAKE_MODE'),config:drPublicConfig_(),statuses:['New','Contacted','Scheduled','Closed'],requests:drOwnerRows_()};}
function drOwnerRows_(){var auth=drOwner_(),sheet=SpreadsheetApp.openById(auth.properties.getProperty('REQUESTS_SHEET_ID')).getSheetByName('Demo Requests');if(sheet.getLastRow()<2)return [];return sheet.getRange(2,1,sheet.getLastRow()-1,14).getValues().map(function(r){return {id:String(r[0]),received:String(r[1]),name:String(r[3]),contact:String(r[4]),service:String(r[5]),vehicle:String(r[6]),issue:String(r[7]),preferredTime:String(r[8]),status:drStatus_(r[11]),notification:String(r[12])};}).reverse();}
function drStatus_(value){var v=String(value||'').toLowerCase();return ({new:'New',contacted:'Contacted',scheduled:'Scheduled',closed:'Closed'})[v]||'New';}
function ownerUpdateStatus(id,status,expected){var auth=drOwner_();if(['New','Contacted','Scheduled','Closed'].indexOf(status)<0||typeof id!=='string')throw Error('INVALID_STATUS');var lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{var sheet=SpreadsheetApp.openById(auth.properties.getProperty('REQUESTS_SHEET_ID')).getSheetByName('Demo Requests'),rows=sheet.getRange(2,1,Math.max(1,sheet.getLastRow()-1),14).getValues();for(var i=0;i<rows.length;i++)if(rows[i][0]===id){if(drStatus_(rows[i][11])!==expected)throw Error('CONFLICT: refresh before updating.');sheet.getRange(i+2,12).setValue(status);SpreadsheetApp.flush();return {ok:true,id:id,status:status};}throw Error('NOT_FOUND');}finally{lock.releaseLock();}}
function ownerSaveSettings(c){var auth=drOwner_();if(!c||!/^[a-z0-9-]{3,40}$/.test(c.id)||typeof c.name!=='string'||!c.name.trim()||c.name.length>80)throw Error('Invalid shop ID or name');var clean={id:c.id,name:c.name.trim(),fictional:true};['city','hours','greeting','logoUrl'].forEach(function(k){if(typeof c[k]!=='string'||c[k].length>(k==='greeting'?1000:500))throw Error('Invalid '+k);clean[k]=c[k];});if(clean.logoUrl&&!/^https:\/\//.test(clean.logoUrl))throw Error('Logo must use HTTPS');clean.colors={};['primary','accent','background'].forEach(function(k){if(!c.colors||!/^#[0-9a-f]{6}$/i.test(c.colors[k]))throw Error('Invalid color');clean.colors[k]=c.colors[k];});clean.contact={};['email','phone','address'].forEach(function(k){if(!c.contact||typeof c.contact[k]!=='string'||c.contact[k].length>200)throw Error('Invalid contact');clean.contact[k]=c.contact[k];});if(!Array.isArray(c.services)||!c.services.length||c.services.length>20||c.services.some(function(s){return typeof s!=='string'||!s.trim()||s.length>80;}))throw Error('Invalid services');clean.services=c.services.map(function(s){return s.trim();});auth.properties.setProperty('SHOP_CONFIG',JSON.stringify(clean));return {ok:true,config:clean,notificationEmail:auth.email};}
function runOwnerSmokeTest(){var data=ownerBootstrap();if(data.requests.length){var row=data.requests[0],old=row.status;try{ownerUpdateStatus(row.id,'Scheduled',old);if(drOwnerRows_().filter(function(r){return r.id===row.id;})[0].status!=='Scheduled')throw Error('Status was not persisted');}finally{var current=drOwnerRows_().filter(function(r){return r.id===row.id;})[0];if(current&&current.status!==old)ownerUpdateStatus(row.id,old,current.status);}}ownerSaveSettings(data.config);console.log(JSON.stringify({ownerAuthorized:true,requests:data.requests.length,statusRoundTrip:'PASS, original restored',settingsRoundTrip:'PASS',realCollection:false,mailSent:false}));}

function drOwnerHtml_(){return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n:root{font:15px system-ui;color:#182321;background:#f5f7f2}*{box-sizing:border-box}body{margin:0}main{max-width:1100px;margin:auto;padding:28px}header,.toolbar,.row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}h1{font-size:30px;letter-spacing:-1px;margin:10px 0}h2{font-size:21px}p{line-height:1.6}.muted{color:#687367;font-size:13px}.notice{padding:14px 18px;background:#e8f3d6;border:1px solid #cbdcb5;border-radius:10px}button,input,select,textarea{font:inherit;border:1px solid #ccd5c6;border-radius:7px;padding:11px;background:white;color:inherit}button{cursor:pointer;background:#182321;color:white}button.secondary{background:white;color:#182321}button:disabled{opacity:.5;cursor:wait}input{min-width:0}input[type=search]{flex:1}a{color:inherit}#requests{display:grid;gap:15px;margin-top:20px}.card{padding:22px;background:white;border:1px solid #dce3d6;border-radius:12px}.card h2{margin:0}.badge{font-size:12px;background:#d7fa75;padding:6px 10px;border-radius:6px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:18px 0}.label{font-size:11px;color:#697560;text-transform:uppercase;letter-spacing:1px}.value{white-space:pre-wrap;overflow-wrap:anywhere;margin-top:4px}.full{grid-column:1/-1}.toolbar{margin-top:24px}#message{white-space:pre-wrap;min-height:24px;color:#4b632f}.error{color:#963b2f!important}details{margin-top:30px;padding:20px;border:1px solid #dce3d6;background:white;border-radius:10px}summary{cursor:pointer;font-weight:700}.settings{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px}label{display:flex;flex-direction:column;gap:6px;font-size:13px}textarea{min-height:95px;resize:vertical}.settings .full{grid-column:1/-1}.count{font-size:13px;color:#617052}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #7da33f;outline-offset:3px}@media(max-width:600px){main{padding:18px}.grid,.settings{grid-template-columns:1fr}.full,.settings .full{grid-column:auto}.toolbar>*{width:100%}.card{padding:17px}h1{font-size:26px}.row{align-items:flex-start}}\n</style></head><body><main><header><div><div class=\"muted\">AUTOLEAD AI / PRIVATE OWNER WORKSPACE</div><h1>Service request inbox</h1><p id=\"identity\" class=\"muted\">Checking Google authorization…</p></div><button id=\"refresh\">Refresh requests</button></header><p class=\"notice\"><strong>Test mode. Fictional requests only.</strong> Status changes are internal. “Scheduled” does not book a calendar appointment or notify a customer. No commercial email is sent.</p><p id=\"message\" role=\"status\" aria-live=\"polite\"></p><div class=\"toolbar\"><input id=\"search\" type=\"search\" aria-label=\"Search requests\" placeholder=\"Search name, contact, vehicle or concern\"><select id=\"filter\" aria-label=\"Filter status\"><option>All statuses</option><option>New</option><option>Contacted</option><option>Scheduled</option><option>Closed</option></select><span id=\"count\" class=\"count\"></span></div><section id=\"requests\" aria-label=\"Requests\"></section><details><summary>Shop branding and information</summary><p class=\"muted\">Public settings are loaded by your website. Each client must use their own Apps Script project, Google owner and private Sheet. Real collection stays disabled.</p><form id=\"settings\" class=\"settings\"><label>Shop ID<input name=\"id\" required pattern=\"[a-z0-9-]{3,40}\"></label><label>Shop name<input name=\"name\" required maxlength=\"80\"></label><label>City<input name=\"city\" maxlength=\"150\"></label><label>Logo URL (HTTPS, optional)<input name=\"logoUrl\" type=\"url\"></label><label>Primary color<input name=\"primary\" type=\"color\"></label><label>Accent color<input name=\"accent\" type=\"color\"></label><label>Background color<input name=\"background\" type=\"color\"></label><label>Public business email<input name=\"email\" type=\"email\"></label><label>Public business phone<input name=\"phone\"></label><label>Public address<input name=\"address\"></label><label class=\"full\">Hours and timezone<textarea name=\"hours\" maxlength=\"500\"></textarea></label><label class=\"full\">Services (one per line)<textarea name=\"services\" required></textarea></label><label class=\"full\">Greeting<textarea name=\"greeting\" maxlength=\"1000\" required></textarea></label><p class=\"full muted\" id=\"recipient\"></p><div class=\"full\"><button id=\"save\" type=\"submit\">Save public settings</button></div></form></details><p class=\"muted\">Requests are read from the owner’s private Google Sheet. Nothing is kept in localStorage by this dashboard. Refresh after changes from another session. Test rows and emails should be removed manually within seven days.</p></main><script>\nlet data=[],config=null;const $=s=>document.querySelector(s),statuses=['New','Contacted','Scheduled','Closed'];\nfunction tell(text,error=false){$('#message').textContent=text;$('#message').classList.toggle('error',error);}\nfunction fail(error){tell(error.message||'The server could not complete this action. Refresh and try again.',true);$('#refresh').disabled=false;$('#save').disabled=false;}\nfunction node(tag,text,cls){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;}\nfunction load(){tell('Loading private requests…');$('#refresh').disabled=true;google.script.run.withSuccessHandler(result=>{data=result.requests;config=result.config;$('#identity').textContent=result.email+' · Server mode: '+result.mode;$('#recipient').textContent='Notification email: '+result.email+' (verified Google owner). To use another recipient, provision that owner’s isolated project. This public form cannot redirect notifications.';fillSettings();render();tell('Requests refreshed from the server.');$('#refresh').disabled=false;}).withFailureHandler(fail).ownerBootstrap();}\nfunction render(){const q=$('#search').value.trim().toLowerCase(),status=$('#filter').value,visible=data.filter(r=>(status==='All statuses'||r.status===status)&&[r.name,r.contact,r.vehicle,r.issue,r.service,r.id].join(' ').toLowerCase().includes(q));$('#count').textContent=visible.length+' of '+data.length+' requests';$('#requests').replaceChildren();if(!visible.length){$('#requests').append(node('p','No matching requests. Try another search or status.','card'));return;}visible.forEach(r=>{const card=node('article',undefined,'card'),head=node('div',undefined,'row'),name=node('div');name.append(node('h2',r.name),node('p',r.received+' · '+r.id,'muted'));head.append(name,node('span',r.status,'badge'));card.append(head);const grid=node('div',undefined,'grid');[['Contact',r.contact],['Vehicle',r.vehicle],['Service category',r.service],['Preferred time — not confirmed',r.preferredTime],['Customer’s description',r.issue],['Owner notification',r.notification]].forEach(([label,value])=>{const cell=node('div');cell.append(node('div',label,'label'),node('div',value,'value'));grid.append(cell);});card.append(grid);const row=node('div',undefined,'row'),select=node('select');select.setAttribute('aria-label','Status for '+r.name+' '+r.id);statuses.forEach(s=>{const o=node('option',s);o.selected=s===r.status;select.append(o);});const update=node('button','Save status');update.onclick=()=>{update.disabled=true;google.script.run.withSuccessHandler(result=>{r.status=result.status;render();tell('Status saved on the server. No customer message was sent.');}).withFailureHandler(error=>{update.disabled=false;fail(error);}).ownerUpdateStatus(r.id,select.value,r.status);};row.append(select,update);card.append(row);$('#requests').append(card);});}\nfunction fillSettings(){if(!config)return;const f=$('#settings');['id','name','city','logoUrl','hours','greeting'].forEach(k=>f.elements[k].value=config[k]||'');['primary','accent','background'].forEach(k=>f.elements[k].value=config.colors[k]);['email','phone','address'].forEach(k=>f.elements[k].value=config.contact[k]||'');f.elements.services.value=config.services.join('\\n');}\n$('#settings').onsubmit=e=>{e.preventDefault();const f=e.currentTarget,c={};['id','name','city','logoUrl','hours','greeting'].forEach(k=>c[k]=f.elements[k].value.trim());c.colors={};['primary','accent','background'].forEach(k=>c.colors[k]=f.elements[k].value);c.contact={};['email','phone','address'].forEach(k=>c.contact[k]=f.elements[k].value.trim());c.services=f.elements.services.value.split('\\n').map(s=>s.trim()).filter(Boolean);$('#save').disabled=true;google.script.run.withSuccessHandler(result=>{config=result.config;fillSettings();$('#save').disabled=false;tell('Public shop settings saved. Reload the public website to see them. Real collection remains disabled.');}).withFailureHandler(fail).ownerSaveSettings(c);};$('#refresh').onclick=load;$('#search').oninput=render;$('#filter').onchange=render;load();\n</script></body></html>\n";}
