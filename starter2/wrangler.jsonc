{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autolead-starter2-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "MODE": "TEST_ONLY",
    "MAIL_TRANSPORT": "SIMULATED",
    "INTAKE_ENABLED": "true",
    "GOOGLE_CLIENT_ID": "NOT_CONNECTED",
    "OWNER_MEMBERSHIPS": "{}"
  },
  "d1_databases": [
    {"binding": "BAYLINE_DB", "database_name": "starter2-bayline-test", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations", "remote": false},
    {"binding": "ISOLATION_DB", "database_name": "starter2-isolation-test", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations", "remote": false}
  ]
}
